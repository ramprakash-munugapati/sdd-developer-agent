<?xml version="1.0"?>
<!DOCTYPE checkstyle PUBLIC
  "-//Checkstyle//DTD Configuration 1.3//EN"
  "https://checkstyle.org/dtds/checkstyle-1.3.dtd">
<checkstyle>
  <module name="Checker">
    <property name="charset" value="UTF-8"/>
  </module>
  <module name="Indentation">
    <property name="indentSize" value="4"/>
    <property name="tabSize" value="4"/>
  </module>
  <module name="LineLength">
    <property name="max" value="120"/>
  </module>
  <module name="AvoidStarImport"/>
  <module name="AvoidInlineIf"/>
  <module name="NeedBraces">
    <property name="marks" value="|:?+"/>
  </module>
  <module name="RoundedParen"/>
</checkstyle>